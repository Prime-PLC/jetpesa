rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.uid == userId && request.resource.data.walletBalance == 0;
      allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.walletBalance == resource.data.walletBalance;
      allow delete: if false;
    }
    match /phoneLookup/{phone} { allow read, write: if false; }
    match /deposits/{depositId} { allow read: if request.auth != null && resource.data.userId == request.auth.uid; allow write: if false; }
  }
}